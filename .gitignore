*-test.md
*copy.md
.jekyll-cache/*
test/*
assets/package-lock.json
*/.jekyll-cache/*

# Site check tooling: outputs and environment
_tools/runs/
_tools/.venv/
_tools/linkcheck.json
__pycache__/
