---
---
[
  {% for post in site.posts %}
  {
    "title"    : {{ post.title | strip_newlines | jsonify }},
    "category" : {{ post.category | jsonify }},
    "tags"     : {{ post.tags | join: ', ' | prepend: " " | jsonify }},
    "url"      : {{ post.url | relative_url | jsonify }},
    "date"     : {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "excerpt"  : {{ post.content | strip_html | truncatewords: 40 | jsonify }},
  "content"  : {{ post.content | strip_html | jsonify }}
} {% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.portfolio.size > 0 %},{% endif %}
  {% for page in site.portfolio %}
  {
  {% if page.title != nil %}
  "title"    : {{ page.title | strip_newlines | jsonify }},
  "category" : {{ page.category | jsonify }},
  "tags"     : {{ page.tags | join: ', ' | prepend: " " | jsonify }},
  "url"      : {{ page.url | relative_url | jsonify }},
  "date"     : {{ page.date | date: "%B %-d, %Y" | jsonify }},
  "excerpt"  : {{ page.content | strip_html | truncatewords: 40 | jsonify }},
  "content"  : {{ page.content | strip_html | jsonify }}
  {% endif %}
} {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
